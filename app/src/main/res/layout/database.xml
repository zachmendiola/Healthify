<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:id="@+id/editTextGoal"
        android:layout_width="188dp"
        android:layout_height="44dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="170dp"
        android:hint="Goal weight (lbs)"
        android:inputType="numberDecimal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonSetGoal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="Set Goal"
        app:layout_constraintBottom_toBottomOf="@id/editTextGoal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/editTextGoal" />

    <TextView
        android:id="@+id/textViewProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextGoal" />

    <TableLayout
        android:id="@+id/tableLayout"
        android:layout_width="411dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewProgress">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textView12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete?" />

            <TextView
                android:id="@+id/textView11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weight (lbs)" />

            <TextView
                android:id="@+id/textView10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <CheckBox
                android:id="@+id/checkBox2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/editTextText"
                android:layout_width="172dp"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="text"
                android:text="Jen's Birthday" />

            <EditText
                android:id="@+id/editTextDate"
                android:layout_width="191dp"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="date"
                android:text="08/22/1994" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <CheckBox
                android:id="@+id/checkBox2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/editTextText"
                android:layout_width="172dp"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="text"
                android:text="Jen's Birthday" />

            <EditText
                android:id="@+id/editTextDate"
                android:layout_width="191dp"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="date"
                android:text="08/22/1994" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <CheckBox
                android:id="@+id/checkBox2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/editTextText"
                android:layout_width="172dp"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="text"
                android:text="Jen's Birthday" />

            <EditText
                android:id="@+id/editTextDate"
                android:layout_width="191dp"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="date"
                android:text="08/22/1994" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <CheckBox
                android:id="@+id/checkBox2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/editTextText"
                android:layout_width="172dp"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="text"
                android:text="Jen's Birthday" />

            <EditText
                android:id="@+id/editTextDate"
                android:layout_width="191dp"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="date"
                android:text="08/22/1994" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <CheckBox
                android:id="@+id/checkBox2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/editTextText"
                android:layout_width="172dp"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="text"
                android:text="Jen's Birthday" />

            <EditText
                android:id="@+id/editTextDate"
                android:layout_width="191dp"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="date"
                android:text="08/22/1994" />

        </TableRow>

    </TableLayout>

    <TextView
        android:id="@+id/textView13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="172dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="157dp"
        android:text="Add a Weight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/editTextText5"
        android:layout_width="188dp"
        android:layout_height="44dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="57dp"
        android:layout_marginEnd="205dp"
        android:ems="10"
        android:hint="Weight (lbs)"
        android:inputType="numberDecimal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/editTextDate2"
        android:layout_width="163dp"
        android:layout_height="44dp"
        android:layout_marginTop="57dp"
        android:layout_marginEnd="16dp"
        android:ems="10"
        android:hint="MM/DD/YYYY"
        android:inputType="date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="111dp"
        android:text="Add Weight"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="147dp" />
</androidx.constraintlayout.widget.ConstraintLayout>